{
  "name": "cliffly-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host localhost",
    "build": "vite build",
    "test": "node --test web/tests/*.test.js",
    "test:e2e": "playwright test",
    "test:depth": "node scripts/verify-depth.mjs",
    "predev": "node scripts/prepare-onnx.mjs",
    "prebuild": "node scripts/prepare-onnx.mjs",
    "preview": "vite preview --host localhost",
    "pretest:e2e": "npm run build",
    "pretest:depth": "npm run build",
    "format": "prettier --write web scripts *.js *.json README.md docs/PLANO_PRODUTO.md docs/VALIDACAO.md docs/issues .github/workflows",
    "format:check": "prettier --check web scripts *.js *.json README.md docs/PLANO_PRODUTO.md docs/VALIDACAO.md docs/issues .github/workflows"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "prettier": "^3.9.9",
    "vite": "^7.1.0"
  }
}
